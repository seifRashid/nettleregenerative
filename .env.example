# ==============================================================================
# Nettle Regenerative - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit your .env.local file to version control.

# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Identity
# Must be an address from a domain verified in your Resend account
# Example: "Nettle Regenerative <hello@nettleregenerative.com>"
RESEND_FROM_EMAIL=hello@nettleregenerative.com

# Resend Inbound Webhook Signing Secret
# Found in Resend Dashboard -> Webhooks -> [Your Webhook] -> Signing Secret
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Admin Authentication
# Used to log into the private email management dashboard at /admin/emails
ADMIN_EMAIL=admin@nettleregenerative.com
ADMIN_PASSWORD=change_this_to_a_strong_password_123!

# Session Encryption Secret
# Must be a secure random string (minimum 32 characters)
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace_this_with_a_secure_random_string_at_least_32_chars_long

# Optional: Admin notification recipient for new contact form submissions
# If not specified, ADMIN_EMAIL will be used.
ADMIN_NOTIFICATION_EMAIL=admin@nettleregenerative.com

# Storage Adapter (default: file)
# Options: 'file' (stores in data/emails.json, ideal for local/dedicated node servers)
STORAGE_TYPE=file
